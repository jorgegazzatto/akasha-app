# ===================================================
# AKASHA BACKEND - ENVIRONMENT CONFIGURATION
# ===================================================

PROJECT_NAME="Akasha App API"
API_V1_STR="/api/v1"
ENVIRONMENT="development" # development | production

# SEGURANÇA & JWT
SECRET_KEY="SUA_CHAVE_SECRETA_SUPER_SEGURA_AQUI"
ACCESS_TOKEN_EXPIRE_MINUTES=43200 # 30 dias

# BANCO DE DADOS POSTGRESQL (VPS ou Local)
DATABASE_URL="postgresql+asyncpg://akasha_user:akasha_secure_pass@localhost:5432/akasha_db"

# REDIS (Filas Celery)
REDIS_URL="redis://localhost:6379/0"

# IA - ROTEIRO & STORYTELLING
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY=""

# IA - VOZ & CLONAGEM (ELEVENLABS)
ELEVENLABS_API_KEY=""

# STORAGE DE ÁUDIO (CLOUDFLARE R2 / S3 - ZERO EGRESS)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="akasha-audios"
R2_PUBLIC_DOMAIN="https://audios.seudominio.com"

# CORS (Domínios autorizados a consumir a API)
ALLOWED_ORIGINS="http://localhost:8081,http://localhost:3000,http://localhost:19006,https://app.seudominio.com"
